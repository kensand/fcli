{
  "name": "@fcli.dev/f",
  "version": "0.2.1",
  "description": "Token-efficient CLI for LLMs to extend and use",
  "type": "module",
  "bin": {
    "f": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "llm",
    "token-efficient",
    "fcli"
  ],
  "author": "fcli.dev",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://fcli.dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@fcli.dev/f": "^0.0.0-stage"
  }
}
